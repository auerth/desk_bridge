<?xml version='1.0' encoding='utf-8'?>
<!--
  Desk Bridge default configuration for the Virtual Display Driver (MttVDD, release 24.12.24 / 25.7.23, x64).
  Install location read by the driver: C:\VirtualDisplayDriver\vdd_settings.xml
  (can be redirected with HKLM\SOFTWARE\MikeTheTech\VirtualDisplayDriver\VDDPATH = "<folder>").
  Schema = the flat schema of the shipped x64 binary (see vdd_settings.upstream.xml). Changes take
  effect when the driver (re)starts: disable/enable the device node, or send RELOAD_DRIVER on the pipe.

  Rules learned from the driver source and its issue tracker:
  * <count> is the number of monitors created when the device starts (min 1).
  * Every <resolution> adds one mode (width x height @ refresh_rate). <global><g_refresh_rate> would
    ADD every listed rate to EVERY resolution (cross product) -> left empty on purpose, so there are
    no duplicate or unwanted modes (e.g. 5120x1440@240).
  * Keep the mode list SHORT. Upstream issues #254/#82 report that the monitor fails to initialise
    with ~100+ modes. This template has 7.
  * <gpu><friendlyname> must equal the DXGI adapter description (DXGI_ADAPTER_DESC.Description) of
    the render GPU, e.g. "NVIDIA GeForce RTX 5060 Laptop GPU". "default" or an unknown name makes the
    driver pick the adapter with the most dedicated VRAM, which is the dGPU on an Optimus laptop.
    crates/display should write the name of the adapter that has the HW encoder.
-->
<vdd_settings>
    <monitors>
        <count>1</count>
    </monitors>
    <gpu>
        <friendlyname>default</friendlyname>
    </gpu>
    <global>
        <!-- intentionally empty: see header -->
    </global>
    <resolutions>
        <!-- Full screen (PC target monitor: 5120x1440) -->
        <resolution><width>5120</width><height>1440</height><refresh_rate>120</refresh_rate></resolution>
        <resolution><width>5120</width><height>1440</height><refresh_rate>60</refresh_rate></resolution>
        <!-- Half width -->
        <resolution><width>2560</width><height>1440</height><refresh_rate>120</refresh_rate></resolution>
        <resolution><width>2560</width><height>1440</height><refresh_rate>60</refresh_rate></resolution>
        <!-- Split variants 2/3 + 1/3. 3413 + 1707 = 5120. UNTESTED: odd widths; if Windows rejects them
             use 3414 + 1706 (also 5120). -->
        <resolution><width>3413</width><height>1440</height><refresh_rate>120</refresh_rate></resolution>
        <resolution><width>1707</width><height>1440</height><refresh_rate>120</refresh_rate></resolution>
        <!-- Safe mode -->
        <resolution><width>1920</width><height>1080</height><refresh_rate>60</refresh_rate></resolution>
    </resolutions>
    <options>
        <CustomEdid>false</CustomEdid>
        <PreventSpoof>false</PreventSpoof>
        <EdidCeaOverride>false</EdidCeaOverride>
        <HardwareCursor>true</HardwareCursor>
        <SDR10bit>false</SDR10bit>
        <HDRPlus>false</HDRPlus>
        <logging>false</logging>
        <debuglogging>false</debuglogging>
    </options>
</vdd_settings>
