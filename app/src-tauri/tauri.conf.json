{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desk Bridge",
  "mainBinaryName": "Desk Bridge",
  "identifier": "com.softwelop.deskbridge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": ".." },
    "beforeBuildCommand": { "script": "npm run build", "cwd": ".." }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Desk Bridge",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "softwelop",
    "copyright": "Copyright (c) softwelop",
    "category": "Utility",
    "shortDescription": "One desk, two computers, zero switching.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../installer/stage/deskbridge-agent.exe": "deskbridge-agent.exe",
      "../../installer/stage/deskbridge-service.exe": "deskbridge-service.exe",
      "../../installer/stage/deskbridge-setup.exe": "deskbridge-setup.exe",
      "../../installer/stage/ffmpeg/*.dll": "./",
      "../../installer/stage/ffmpeg/FFMPEG-LICENSE.txt": "licenses/FFMPEG-LICENSE.txt",
      "../../THIRD_PARTY_LICENSES.html": "licenses/THIRD_PARTY_LICENSES.html",
      "../../LICENSE-MIT": "licenses/LICENSE-MIT",
      "../../LICENSE-APACHE": "licenses/LICENSE-APACHE"
    },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "../../installer/hooks.nsh",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/softwelop/desk-bridge/releases/latest/download/latest.json"],
      "pubkey": "TODO-REPLACE-WITH-MINISIGN-PUBLIC-KEY (generate with `npm run tauri signer generate`; see app/README.md)",
      "windows": { "installMode": "passive" }
    }
  }
}
